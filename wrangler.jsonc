{
  "$schema": "https://raw.githubusercontent.com/cloudflare/wrangler/main/config-schema.json",
  "name": "one-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2024-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "one-tracker-local",
      "database_id": "local",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "NODE_ENV": "development",
    "VITE_PORT": "5175",
    "APP_BASE_URL": "http://localhost:8787"
  },
  "env": {
    "production": {
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist/client"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "one-tracker",
          "database_id": "42bf06cd-90a1-4ed0-a2b8-2414a961337a",
          "migrations_dir": "drizzle"
        }
      ],
      "vars": {
        "NODE_ENV": "production",
        "VITE_PORT": "5175",
        "APP_BASE_URL": "https://ot.nekro.ai"
      }
    }
  }
}
